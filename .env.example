# Copy to .env to override any of these defaults used by docker-compose.yml.

POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitoring

# Host port for the dashboard (http://localhost:8080)
DASHBOARD_PORT=8080

# How often the simulator ships a batch of metrics, in milliseconds
TICK_MS=2000

# How long raw metric samples are kept in PostgreSQL
RETENTION_MINUTES=60

# Comma-separated webhook targets. Add a real Slack/Discord/webhook.site URL to see alerts outside the stack.
WEBHOOK_URLS=http://webhook-receiver:4002/hooks/incidents

# Share of webhook deliveries the mock receiver rejects (0-1), to show retries working
WEBHOOK_FAIL_RATE=0
